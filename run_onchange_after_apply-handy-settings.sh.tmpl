{{ if eq .chezmoi.os "darwin" -}}
#!/bin/sh

# Merge portable Handy settings into settings_store.json while preserving local
# API keys. History, recordings, and downloaded models are never tracked.
#
# Handy writes this file while running. Refuse to race it; quit Handy and rerun
# `chezmoi apply` if this script reports that the app is open.

set -eu

config_dir="$HOME/Library/Application Support/com.pais.handy"
config="$config_dir/settings_store.json"

if pgrep -x "handy" >/dev/null 2>&1; then
    echo "Handy is running; quit it and rerun chezmoi apply." >&2
    exit 1
fi

mkdir -p "$config_dir"
settings_file="$(mktemp "${TMPDIR:-/tmp}/handy-settings.XXXXXX")"
output_file="$(mktemp "$config_dir/.settings_store.json.XXXXXX")"
trap 'rm -f "$settings_file" "$output_file"' EXIT HUP INT TERM

cat > "$settings_file" <<'HANDY_SETTINGS'
{{ template "handy-settings.json" . }}
HANDY_SETTINGS

if [ -f "$config" ]; then
    jq --slurpfile desired "$settings_file" '
        . as $current
        | . * $desired[0]
        | if ($current.settings.post_process_api_keys? | type) == "object"
          then .settings.post_process_api_keys = $current.settings.post_process_api_keys
          else .
          end
    ' "$config" > "$output_file"
else
    jq --slurpfile desired "$settings_file" -n '$desired[0]' > "$output_file"
fi

chmod 600 "$output_file"
mv "$output_file" "$config"
{{ end -}}
