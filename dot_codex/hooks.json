{
  "description": "Personal Codex safety hooks migrated from Claude Code.",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "~/.codex/hooks/sudo-guard.sh",
            "statusMessage": "Checking sudo timestamp",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash \"$HOME/.codex/herdr-agent-state.sh\" session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
