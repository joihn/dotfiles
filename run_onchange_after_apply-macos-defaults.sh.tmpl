{{ if eq .chezmoi.os "darwin" -}}
#!/bin/sh

# Apply tracked macOS defaults — system preferences + cherry-picked app prefs.
#
# This file IS the single source of truth: an explicit, declarative list of
# `defaults write` commands (the portable, diffable convention — we never copy
# binary plists). run_onchange: chezmoi re-runs this only when the list below
# changes, and every `defaults write` is idempotent, so re-runs are cheap/safe.
# Guarded for darwin, so it renders to nothing (never runs) on Linux.
#
# Values below were captured from a live machine. To add a setting, discover
# its exact line with:
#   macos-pref-diff            # snapshot -> change a setting in System Settings -> diff
#   macos-pref-diff <domain>   # scope to one domain, e.g. cc.ffitch.shottr

set -eu

# --- Keyboard ---
defaults write NSGlobalDomain KeyRepeat -int 2
defaults write NSGlobalDomain InitialKeyRepeat -int 33

# --- Dock ---
defaults write com.apple.dock autohide -bool true
defaults write com.apple.dock tilesize -int 48
defaults write com.apple.dock orientation -string "left"

# --- Finder ---
defaults write com.apple.finder FXPreferredViewStyle -string "Nlsv"
defaults write com.apple.finder ShowPathbar -bool true

# --- Default file viewer ---
defaults write NSGlobalDomain NSFileViewer -string "com.binarynights.ForkLift"

# --- ForkLift ---
# Include nested folders in searches started with Control-F
defaults write com.binarynights.ForkLift recursiveSearch -bool true

# Copy Path > UNIX (absolute POSIX path): Command-Shift-C
defaults write com.binarynights.ForkLift NSUserKeyEquivalents -dict-add "UNIX" '@$c'

# duti rejects public.folder with error -50, so use ForkLift's documented
# LaunchServices setting. Only append it when the exact handler is absent;
# `defaults write -array-add` otherwise creates duplicates on every apply.
if ! defaults read com.apple.LaunchServices/com.apple.launchservices.secure LSHandlers 2>/dev/null | awk '
    /^[[:space:]]*\{/ { folder = 0; forklift = 0 }
    /LSHandlerContentType = "public.folder";/ { folder = 1 }
    /LSHandlerRoleAll = "com.binarynights.ForkLift";/ { forklift = 1 }
    /^[[:space:]]*\},?$/ { if (folder && forklift) found = 1 }
    END { exit(found ? 0 : 1) }
'; then
    defaults write com.apple.LaunchServices/com.apple.launchservices.secure LSHandlers -array-add '{LSHandlerContentType="public.folder";LSHandlerRoleAll="com.binarynights.ForkLift";}'
fi

# --- Screenshots ---
defaults write com.apple.screencapture location -string "~/Pictures/"

# --- Spotlight: categories EXCLUDED from search results ---
# Counterintuitively, `EnabledPreferenceRules` is the list of DISABLED categories
# (verified empirically: enabling a category REMOVES its id; disabling ADDS it).
# So every id below is a category that is turned OFF. Captured verbatim.
# To update: toggle categories in System Settings > Spotlight, then re-capture with:
#   defaults read com.apple.Spotlight EnabledPreferenceRules | grep -oE '"[^"]+"'
defaults write com.apple.Spotlight EnabledPreferenceRules -array \
    "com.apple.AppStore" \
    "com.apple.iBooksX" \
    "com.apple.calculator" \
    "com.apple.iCal" \
    "com.apple.AddressBook" \
    "com.apple.Dictionary" \
    "com.apple.freeform" \
    "com.apple.iWork.Keynote" \
    "com.apple.mail" \
    "ch.admin.meteoswiss" \
    "com.apple.Notes" \
    "com.apple.iWork.Pages" \
    "com.apple.Photos" \
    "com.apple.podcasts" \
    "com.apple.reminders" \
    "com.apple.Safari" \
    "com.apple.shortcuts" \
    "com.apple.tips" \
    "app.tuple.app" \
    "com.apple.VoiceMemos" \
    "com.apple.Safari.WebApp" \
    "System.files" \
    "System.folders" \
    "System.iphoneApps"

# --- Shottr (cc.ffitch.shottr) — user prefs only (no telemetry / IDs / update state) ---
defaults write cc.ffitch.shottr afterGrabCopy -bool true
defaults write cc.ffitch.shottr afterGrabSave -bool false
defaults write cc.ffitch.shottr afterGrabShow -bool false
defaults write cc.ffitch.shottr allowTelemetry -bool false
defaults write cc.ffitch.shottr altZoomDirection -bool false
defaults write cc.ffitch.shottr alwaysOnTop -bool false
defaults write cc.ffitch.shottr areaCaptureMode -string "preview"
defaults write cc.ffitch.shottr areaCustomGrabber -bool true
defaults write cc.ffitch.shottr captureCursor -string "auto"
defaults write cc.ffitch.shottr colorFormat -string "HEX"
defaults write cc.ffitch.shottr copyOnEsc -bool true
defaults write cc.ffitch.shottr customBackdropColor -string "#6080A0"
defaults write cc.ffitch.shottr customGradFrom -string "#221448"
defaults write cc.ffitch.shottr customGradTo -string "#919BD2"
defaults write cc.ffitch.shottr downscaleOnSave -bool false
defaults write cc.ffitch.shottr expandableCanvas -bool true
defaults write cc.ffitch.shottr notificationType -string "custom"
defaults write cc.ffitch.shottr ocrRemoveBreaks -bool false
defaults write cc.ffitch.shottr preferLargeWindow -bool true
defaults write cc.ffitch.shottr primaryOCRLang -string "en-US"
defaults write cc.ffitch.shottr realPixels -bool false
defaults write cc.ffitch.shottr saveFormat -string "Auto"
defaults write cc.ffitch.shottr saveOnEsc -bool false
defaults write cc.ffitch.shottr scrollingManualEnabled -bool false
defaults write cc.ffitch.shottr scrollingMax -int 20000
defaults write cc.ffitch.shottr scrollingReverseAutoscroll -bool false
defaults write cc.ffitch.shottr scrollingSpeed -int 2
defaults write cc.ffitch.shottr snappingMode -int 2
defaults write cc.ffitch.shottr thumbnailClosing -string "manual"
defaults write cc.ffitch.shottr uploadMode -string "none"
defaults write cc.ffitch.shottr uploadS3PresignExpiration -int 604800
defaults write cc.ffitch.shottr uploadS3SharingMode -string "none"
defaults write cc.ffitch.shottr windowShadow -string "transparent"
defaults write cc.ffitch.shottr windowSolidColor -string "#404448"

# --- Contexts (com.contextsformac.Contexts) — window switcher prefs ---
# (excludes install id, usage counters, AppCenter telemetry, Sparkle state)
defaults write com.contextsformac.Contexts CTAppearanceTheme -string "CTAppearanceNamedVibrantDark"
defaults write com.contextsformac.Contexts CTPreferenceAppearanceContentSizeCategory -int 3
defaults write com.contextsformac.Contexts CTPreferenceApplicationSlideGestureSelectionMode -string "CTSlideGestureSelectionModePanel"
defaults write com.contextsformac.Contexts CTPreferenceInputDoubleTouchSwitchGestureActive -bool true
defaults write com.contextsformac.Contexts CTPreferenceInputSourceIdToUse -string "kCTInputSourceIdNone"
defaults write com.contextsformac.Contexts CTPreferencePanelRecentSwitcherShowAfterDelay -bool false
defaults write com.contextsformac.Contexts CTPreferenceRecentItemsSwitcherSearchEnabled -bool false
defaults write com.contextsformac.Contexts CTPreferenceSidebarDisplayMode -string "CTDisplayModeNone"
defaults write com.contextsformac.Contexts CTPreferenceSidebarWidth -int 0
defaults write com.contextsformac.Contexts CTSidebarHorizontalAlignment -string "CTWindowHorizontalAlignmentRight"
defaults write com.contextsformac.Contexts CTSidebarInactiveMaximumWidth -int 1
# These two NSKeyedArchiver blobs contain only the configured shortcuts and
# switcher definitions. They exclude app-instance and analytics identifiers.
defaults write com.contextsformac.Contexts CTPreferenceSearchShortcutModal -data ''
defaults write com.contextsformac.Contexts CTPreferenceSwitchers -data ''

# --- Moom (com.manytricks.Moom) — nested controls + portable prefs ---
# Moom mixes these values with window geometry and Sparkle state. Merge only
# the curated fragment so local/volatile values survive on each Mac.
defaults write com.manytricks.Moom 'Grid Spacing' -bool true
defaults write com.manytricks.Moom 'Grid Spacing: Auto-Enabled Default Spacing' -bool true
defaults write com.manytricks.Moom 'Grid Spacing: Gap' -int 1
defaults write com.manytricks.Moom Hover -bool false
defaults write com.manytricks.Moom 'Key Control: Arrow' -int 31
defaults write com.manytricks.Moom 'Mouse Controls Trigger' -int 0
defaults write com.manytricks.Moom Snap -bool true
defaults write com.manytricks.Moom 'Snap Delay' -float 0
defaults write com.manytricks.Moom 'Snap: 3' -int 11

moom_settings_file="$(mktemp "${TMPDIR:-/tmp}/moom-settings.XXXXXX")"
moom_preferences_file="$(mktemp "${TMPDIR:-/tmp}/moom-preferences.XXXXXX")"
trap 'rm -f "$moom_settings_file" "$moom_preferences_file"' EXIT HUP INT TERM

cat > "$moom_settings_file" <<'MOOM_SETTINGS'
{{ template "moom-settings.json" . }}
MOOM_SETTINGS

if ! defaults export com.manytricks.Moom - > "$moom_preferences_file" 2>/dev/null; then
    plutil -create xml1 "$moom_preferences_file"
fi

jq -r 'keys[]' "$moom_settings_file" | while IFS= read -r preference_key; do
    preference_value="$(jq -c --arg key "$preference_key" '.[$key]' "$moom_settings_file")"
    if plutil -type "$preference_key" "$moom_preferences_file" >/dev/null 2>&1; then
        plutil -replace "$preference_key" -json "$preference_value" "$moom_preferences_file"
    else
        plutil -insert "$preference_key" -json "$preference_value" "$moom_preferences_file"
    fi
done

defaults import com.manytricks.Moom "$moom_preferences_file"
rm -f "$moom_settings_file" "$moom_preferences_file"
trap - EXIT HUP INT TERM

# --- LinearMouse (com.lujjjh.LinearMouse) — UI prefs only ---
# Device/pointer/scroll settings live in ~/.config/linearmouse/linearmouse.json.
defaults write com.lujjjh.LinearMouse autoSwitchToActiveDevice -bool false
defaults write com.lujjjh.LinearMouse menuBarVisibilityMode -string "always"

# --- Maccy (org.p0deje.Maccy) — clipboard manager prefs ---
# (excludes window position/size, migrations, Sparkle state, pasteboard-type cache)
defaults write org.p0deje.Maccy KeyboardShortcuts_delete -string '{"carbonKeyCode":51,"carbonModifiers":2048}'
defaults write org.p0deje.Maccy KeyboardShortcuts_pin -string '{"carbonKeyCode":35,"carbonModifiers":2048}'
defaults write org.p0deje.Maccy KeyboardShortcuts_popup -string '{"carbonKeyCode":9,"carbonModifiers":2048}'
defaults write org.p0deje.Maccy pasteByDefault -bool true
defaults write org.p0deje.Maccy pinTo -string "bottom"
defaults write org.p0deje.Maccy popupPosition -string "window"
defaults write org.p0deje.Maccy popupScreen -int 0
defaults write org.p0deje.Maccy previewDelay -int 90000
defaults write org.p0deje.Maccy removeFormattingByDefault -bool true
defaults write org.p0deje.Maccy searchMode -string "fuzzy"
defaults write org.p0deje.Maccy showFooter -bool true
defaults write org.p0deje.Maccy showSearch -bool true
defaults write org.p0deje.Maccy showTitle -bool true

# --- Login items ---
# Google Drive is a GUI app, so "start at boot" means start when this user logs
# in. Keep apply portable by doing nothing on Macs where the app is not installed.
if [ -d "/Applications/Google Drive.app" ]; then
    osascript <<'APPLESCRIPT' || \
        echo "note: could not add Google Drive to Login Items" >&2
tell application "System Events"
    if not (exists login item "Google Drive") then
        make login item at end with properties {name:"Google Drive", path:"/Applications/Google Drive.app", hidden:false}
    end if
end tell
APPLESCRIPT
fi

# Apply changes without a logout.
for app in Dock Finder SystemUIServer Spotlight; do
    killall "$app" 2>/dev/null || true
done
{{ end -}}
