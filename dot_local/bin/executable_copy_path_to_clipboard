#!/usr/bin/env bash

set -u

if [[ $# -ne 1 ]]; then
    printf 'Usage: %s <path>\n' "$0" >&2
    exit 2
fi

path=$1

# Prefer Kitty's terminal protocol. The remaining backends make the same
# shared config work on Wayland, X11, and macOS too.
if command -v kitten >/dev/null 2>&1 && printf '%s' "$path" | kitten clipboard; then
    exit 0
fi
if command -v kitty >/dev/null 2>&1 && printf '%s' "$path" | kitty +kitten clipboard; then
    exit 0
fi
if command -v wl-copy >/dev/null 2>&1 && printf '%s' "$path" | wl-copy; then
    exit 0
fi
if command -v xclip >/dev/null 2>&1 && printf '%s' "$path" | xclip -selection clipboard; then
    exit 0
fi
if command -v xsel >/dev/null 2>&1 && printf '%s' "$path" | xsel --clipboard --input; then
    exit 0
fi
if command -v pbcopy >/dev/null 2>&1 && printf '%s' "$path" | pbcopy; then
    exit 0
fi

printf 'No working clipboard backend found (tried kitten, kitty, wl-copy, xclip, xsel, and pbcopy).\n' >&2
exit 1
