#!/usr/bin/env bash

set -u

if [[ $# -ne 2 ]]; then
    printf 'Usage: %s <line> <file>\n' "$0" >&2
    exit 2
fi

line=$1
file=$2

if [[ ! -f $file ]]; then
    printf 'File not found: %s\n' "$file" >&2
    exit 1
fi

# BROOT_EDITOR is an optional per-machine override. The usual editor
# variables keep this helper portable, with nvim as the final fallback.
editor=${BROOT_EDITOR:-${VISUAL:-${EDITOR:-nvim}}}
read -r -a editor_argv <<< "$editor"

if [[ ${#editor_argv[@]} -eq 0 ]] || ! command -v "${editor_argv[0]}" >/dev/null 2>&1; then
    printf 'Editor not found: %s\n' "$editor" >&2
    exit 127
fi

# Keep this array nonempty: Bash 3.2 treats an empty-array expansion as an
# unbound variable when `set -u` is enabled (the default Bash on macOS).
editor_command=("${editor_argv[@]}")
if [[ $line =~ ^[0-9]+$ ]] && (( line > 0 )); then
    editor_command+=("+$line")
fi
editor_command+=(-- "$file")

# Write a valid, reusable command to zsh's extended history. %q keeps paths
# containing whitespace, quotes, or other shell characters intact.
history_file=${HISTFILE:-${ZDOTDIR:-$HOME}/.zsh_history}
printf -v history_command '%q ' "${editor_command[@]}"
printf ': %s:0;%s\n' "$(date +%s)" "${history_command% }" >> "$history_file"

exec "${editor_command[@]}"
